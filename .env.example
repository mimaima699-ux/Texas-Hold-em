# LLM AI configuration example.
# Usage: copy this file to .env and edit as needed, or inject values via
# environment variables before starting (Windows PowerShell:
#   $env:LLM_BASE_URL="..."; npm start)
# Leave all fields empty/unset to use the local Ollama defaults. When the
# endpoint is unreachable, the server falls back to the built-in heuristic AI.

# --- Local Ollama (default, no changes needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- vLLM / LM Studio and other local services ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- SiliconFlow (free tier; sign up at siliconflow.cn for a key) ---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_API_KEY=sk-xxxxxxxx

# --- OpenRouter (Qwen models with a free tier; openrouter.ai) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct:free
# LLM_API_KEY=sk-or-v1-xxxxxxxx

# --- Alibaba Cloud DashScope compatible mode (free tier) ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxxxxxx

# Per-request timeout (ms)
# LLM_TIMEOUT_MS=12000
# Visible countdown window for an AI player's turn (ms)
# LLM_TURN_MS=14000
